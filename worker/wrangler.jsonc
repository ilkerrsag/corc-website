{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "corc-contact",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"workers_dev": false,
	// The DNS record for the site must be proxied (orange cloud) so Cloudflare runs
	// the worker for this path instead of handing it to the static site.
	"routes": [{ "pattern": "corcdrinks.com/api/contact", "zone_name": "corcdrinks.com" }],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "corc-contact",
			"database_id": "878c5d6d-0a64-4127-be1e-f2477ece44f6"
		}
	],
	// Notifications go out through Brevo. The sender sits on its own subdomain so
	// the SPF and DKIM records of the domain's Google Workspace mail stay as they
	// are. The key itself is a secret: `wrangler secret put BREVO_API_KEY`.
	"vars": {
		"NOTIFY_FROM": "website@notify.corcdrinks.com",
		"NOTIFY_TO": "ilkersag96@gmail.com"
	}
}
